{
  "name": "db-demo-smart-contacts",
  "dockerComposeFile": [
    "docker-compose.devcontainer.yml"
  ],
  // Hauptservice für Entwicklung (Python)
  "service": "fastapi",
  "workspaceFolder": "/workspace",
  // Keine zusaetzlichen Services - alles startet im fastapi-Container-Command
  "runServices": [],
  "shutdownAction": "stopCompose",
  // Ports automatisch weiterleiten + Labels im VS Code Ports-Tab
  "forwardPorts": [
    3000,
    8000
  ],
  // npm install - Stage 2/3 starten sich selbst im Container-Command
  "postCreateCommand": "cd /workspace && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "graphql.vscode-graphql-syntax",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python3",
        "editor.formatOnSave": true,
        "editor.rulers": [
          88
        ],
        "[python]": {
          "editor.defaultFormatter": "ms-python.python"
        }
      }
    }
  }
}