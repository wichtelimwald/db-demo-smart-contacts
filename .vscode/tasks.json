{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "YAML → JSON konvertieren",
      "type": "shell",
      "command": "python3 yaml_to_json.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Stufe 3: FastAPI starten",
      "type": "shell",
      "command": "python3 main.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "server"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Stufe 2: json-graphql starten",
      "type": "shell",
      "command": "npm run stage2",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "server"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "(GraphiQL|JSON Graphql|localhost:3000|running)"
        }
      }
    },
    {
      "label": "Demo: Alle Server starten",
      "dependsOn": [
        "YAML → JSON konvertieren",
        "Stufe 2: json-graphql starten",
        "Stufe 3: FastAPI starten"
      ],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}